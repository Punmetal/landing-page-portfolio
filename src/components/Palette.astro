---
import type { Swatch } from '../data/projects';

interface Props {
  swatches: Swatch[];
}
const { swatches } = Astro.props;

// Pick legible label color per swatch (WCAG relative luminance).
const lum = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ink = (hex: string) => (lum(hex) > 0.18 ? '#000' : '#fff');
---

<ul class="palette" role="list" aria-label="Color palette">
  {
    swatches.map((s) => (
      <li style={`background:${s.hex};color:${ink(s.hex)}`}>
        <span class="hex">{s.hex}</span>
        <span class="name">{s.name}</span>
      </li>
    ))
  }
</ul>

<style>
  .palette {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    border-radius: var(--radius);
    overflow: hidden;
    margin: 0;
  }
  li {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-height: 84px;
    padding: 10px 12px;
    font-size: 0.75rem;
    line-height: 1.2;
  }
  .hex {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .name {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
