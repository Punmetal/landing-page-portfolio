---
// "Selected work" as a bookshelf. Each project is a 3D book showing its spine;
// hovering or focusing a book lifts it and turns it (not quite flat, so the
// depth stays visible) while the others slide aside. The open book leans
// slightly toward the cursor. Clicking jumps to the project. Touch screens
// get the covers in a horizontal scroller.
import { projects } from '../data/projects';

// Cover title is sized from its longest word so nothing touches the edges.
const fit = (t: string) => Math.max(...t.split(/\s+/).map((w) => w.length), 6) * 0.82;
---

<section class="index container" id="work" aria-labelledby="work-title">
  <div class="head">
    <h2 id="work-title" class="section-title display">Selected<br />work</h2>
    <p class="count"><span>{String(projects.length).padStart(2, '0')}</span> projects</p>
  </div>

  <ol class="shelf" role="list">
    {
      projects.map((p) => (
        <li class="book" style={`--book:${p.spine.bg};--ink:${p.spine.ink}`}>
          <a class="book-link" href={`#${p.slug}`} aria-label={`${p.no} ${p.title}`}>
            <span class="book-3d">
              <span class="spine" aria-hidden="true">
                <span class="spine-no">{p.no}</span>
                <span class="spine-title">{p.spine.label}</span>
                <span class="spine-no spine-balance">{p.no}</span>
              </span>
              <span class="cover" aria-hidden="true">
                <span class="cover-no">{p.no}</span>
                <span class="cover-title display" style={`--fit:${fit(p.indexTitle ?? p.title)}`}>
                  {p.indexTitle ?? p.title}
                </span>
                <span class="cover-foot">Tutphong Mungkalakul</span>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<script>
  // Lean the open book toward the cursor (a few degrees), like holding it.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.book-link').forEach((link) => {
    link.addEventListener('pointermove', (e) => {
      if (!fine.matches || still.matches) return;
      const r = link.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      link.style.setProperty('--tilt-y', `${(x * 10).toFixed(2)}deg`);
      link.style.setProperty('--tilt-x', `${(-y * 8).toFixed(2)}deg`);
    });
    link.addEventListener('pointerleave', () => {
      link.style.removeProperty('--tilt-x');
      link.style.removeProperty('--tilt-y');
    });
  });
</script>

<style>
  .index {
    --spine-w: 64px;
    --cover-w: 260px;
    --book-h: 360px;
    --open-w: calc(var(--cover-w) * 0.86 + var(--spine-w) * 0.4);
    --cover-pad: 26px;
    --turn: 0.85s cubic-bezier(0.45, 0.05, 0.25, 1);
    padding-block: var(--section-y);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .count {
    color: var(--c-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .count span {
    color: var(--c-fg);
  }

  /* ---------- Shelf (hover-capable screens) ---------- */
  .shelf {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 56px 0 0; /* headroom for the lifted book */
    perspective: 1600px;
    perspective-origin: 50% 30%;
  }

  .book {
    position: relative;
    flex: none;
    width: var(--spine-w);
    height: var(--book-h);
    transform-style: preserve-3d;
    transition: width var(--turn);
  }
  /* floating shadow on the shelf, grows as the book lifts */
  .book::after {
    content: '';
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.7), transparent);
    opacity: 0.6;
    transform: scale(0.8);
    transition:
      opacity var(--turn),
      transform var(--turn);
    pointer-events: none;
  }
  .book-link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
    outline: none;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 0.35s ease-out;
  }
  .book-3d {
    position: relative;
    display: block;
    width: var(--cover-w);
    height: 100%;
    transform-style: preserve-3d;
    transform-origin: left center;
    /* at rest: spine faces the viewer, cover runs back into the shelf */
    transform: translateX(var(--spine-w)) translateY(0) rotateY(90deg);
    transition: transform var(--turn);
  }

  .spine,
  .cover {
    position: absolute;
    top: 0;
    height: 100%;
    backface-visibility: hidden;
  }

  .spine {
    left: calc(var(--spine-w) * -1);
    width: var(--spine-w);
    transform-origin: right center;
    transform: rotateY(-90deg);
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    align-items: center;
    padding: 18px 0;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0) 35%, rgb(0 0 0 / 0) 65%, rgb(0 0 0 / 0.22)),
      var(--book);
    color: var(--ink);
    border-radius: 3px 0 0 3px;
  }
  .spine-no {
    font-family: var(--f-display);
    font-size: 1.125rem;
    line-height: 1;
  }
  /* invisible twin of the number so the title sits dead centre */
  .spine-balance {
    visibility: hidden;
  }
  .spine-title {
    writing-mode: vertical-rl;
    font-family: var(--f-display);
    font-size: 1rem;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cover {
    left: 0;
    width: var(--cover-w);
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 28px var(--cover-pad) 26px;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.28), rgb(255 255 255 / 0.18) 2.5%, rgb(255 255 255 / 0) 9%, rgb(255 255 255 / 0) 80%, rgb(255 255 255 / 0.08)),
      var(--book);
    color: var(--ink);
    border-radius: 0 6px 6px 0;
  }
  .cover > * {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .cover-no {
    font-family: var(--f-display);
    font-size: 1.5rem;
    line-height: 1;
  }
  .cover-title {
    align-self: center;
    padding-block: 12px;
    font-size: min(1.9rem, calc((var(--cover-w) - var(--cover-pad) * 2) / var(--fit)));
    line-height: 1.04;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .cover-foot {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  /* Open book: hovered/focused one, or the first book when the shelf is idle */
  .book:hover,
  .book:focus-within,
  .shelf:not(:hover):not(:focus-within) .book:first-child {
    width: var(--open-w);
  }
  .book:hover .book-3d,
  .book:focus-within .book-3d,
  .shelf:not(:hover):not(:focus-within) .book:first-child .book-3d {
    /* lifted, turned most of the way but kept at an angle to show depth */
    transform: translateX(calc(var(--spine-w) * 0.4)) translateY(-36px) rotateY(24deg) rotateX(3deg);
  }
  .book:hover .cover > *,
  .book:focus-within .cover > *,
  .shelf:not(:hover):not(:focus-within) .book:first-child .cover > * {
    opacity: 1;
    transition-delay: 0.2s;
  }
  .book:hover::after,
  .book:focus-within::after,
  .shelf:not(:hover):not(:focus-within) .book:first-child::after {
    opacity: 1;
    transform: scale(1.05);
  }
  .book-link:focus-visible .cover {
    box-shadow:
      0 0 0 3px var(--c-bg),
      0 0 0 6px #fff;
  }

  @media (max-width: 1100px) {
    .index {
      --spine-w: 56px;
      --cover-w: 230px;
      --book-h: 320px;
    }
    .spine-title {
      font-size: 0.875rem;
    }
  }

  /* ---------- Touch / narrow: covers in a horizontal scroller ---------- */
  @media (hover: none), (max-width: 760px) {
    .shelf {
      justify-content: flex-start;
      gap: 14px;
      padding: 8px 0 28px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      perspective: none;
      scrollbar-width: thin;
    }
    .book,
    .book:hover,
    .book:focus-within,
    .shelf:not(:hover):not(:focus-within) .book:first-child {
      width: min(64vw, 230px);
      height: auto;
      aspect-ratio: 13 / 18;
      scroll-snap-align: start;
    }
    .book::after {
      display: none;
    }
    .book-link {
      transform: none;
    }
    .book-3d,
    .book:hover .book-3d,
    .book:focus-within .book-3d,
    .shelf:not(:hover):not(:focus-within) .book:first-child .book-3d {
      width: 100%;
      transform: none;
    }
    .spine {
      display: none;
    }
    .index {
      --cover-w: min(64vw, 230px);
      --cover-pad: 22px;
    }
    .cover {
      width: 100%;
      border-radius: 6px;
      padding: 22px var(--cover-pad) 20px;
    }
    .cover > * {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book,
    .book::after,
    .book-link,
    .book-3d {
      transition: none;
    }
  }
</style>
