---
import { projects } from '../data/projects';
import Picture from './Picture.astro';
---

<section class="index container" id="work" aria-labelledby="work-title">
  <div class="head">
    <h2 id="work-title" class="section-title display">Selected<br />work</h2>
    <p class="count"><span>{String(projects.length).padStart(2, '0')}</span> projects</p>
  </div>

  <ol class="cards" role="list">
    {
      projects.map((p) => (
        <li>
          <a class="card" href={`#${p.slug}`}>
            <div class="thumb">
              <Picture name={p.cover} alt="" sizes="(min-width: 1100px) 300px, (min-width: 560px) 45vw, 100vw" />
            </div>
            <span class="card-no display" aria-hidden="true">
              {p.no}
            </span>
            <span class="card-title">{p.indexTitle ?? p.title}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .index {
    padding-block: var(--section-y);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .count {
    color: var(--c-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .count span {
    color: var(--c-fg);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--gap);
    margin: 0;
  }
  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 10px 14px;
    height: 100%;
    padding: 10px 10px 16px;
    border-radius: calc(var(--radius) + 4px);
    background: var(--c-bg-raised);
    text-decoration: none;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    background: #2b2b2b;
  }
  .thumb {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: #111;
  }
  .thumb :global(picture),
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .card:hover .thumb :global(img) {
    transform: scale(1.04);
  }
  .card-no {
    padding-left: 6px;
    color: var(--c-accent);
    font-size: 2rem;
  }
  .card-title {
    font-weight: 700;
    line-height: 1.25;
  }
</style>
