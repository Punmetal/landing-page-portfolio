---
import Picture from './Picture.astro';
import { contact, profile } from '../data/site';
const [intro, ...rest] = profile.about;
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="about-photo">
    <Picture
      name="about-portrait"
      alt="Portrait of Pun looking up, against a red grainy background"
      sizes="(min-width: 900px) 40vw, 100vw"
    />
  </div>

  <div class="about-body">
    <h2 id="about-title" class="section-title display">About<br />me</h2>
    <p class="about-intro">
      My name is <mark>{profile.fullName}</mark>, but you can call me {profile.nickname}.
    </p>
    {rest.map((p) => <p>{p}</p>)}

    <ul class="contact-row" role="list" aria-label="Contact">
      <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
      <li><a href={contact.linkedin.href} rel="noopener" target="_blank">{contact.linkedin.label}</a></li>
      <li><a href={contact.behance.href} rel="noopener" target="_blank">{contact.behance.label}</a></li>
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    max-width: calc(var(--max-w) + var(--gutter) * 2);
    margin-inline: auto;
  }
  .about-photo {
    background: var(--c-hero) url('/media/grain.png');
    overflow: hidden;
  }
  .about-photo :global(img) {
    width: 100%;
    height: 100%;
    max-height: 70svh;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .about-body {
    display: grid;
    align-content: center;
    gap: 20px;
    padding: var(--section-y) var(--gutter);
    font-size: var(--fs-2);
    max-width: 68ch;
  }
  .about-body h2 {
    margin-bottom: 12px;
  }
  mark {
    background: #d01818; /* white text needs a darker red than --c-accent for 4.5:1 */
    color: #fff;
    font-weight: 700;
    padding: 0 0.2em;
    border-radius: 2px;
  }
  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 20px;
    font-size: var(--fs-0);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .contact-row a {
    display: inline-block;
    padding-block: 8px;
    color: var(--c-accent);
    text-decoration: none;
    word-break: break-all;
  }
  .contact-row a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: stretch;
    }
    .about-photo :global(picture),
    .about-photo :global(img) {
      height: 100%;
      max-height: none;
    }
    .about-body {
      padding-left: clamp(40px, 5vw, 80px);
    }
  }
</style>
