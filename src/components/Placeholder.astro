---
// Clearly labelled slot for an asset that does not exist yet. Never fakes content.
interface Props {
  kind: 'image' | 'video' | '3d';
  label: string;
  file: string;
  class?: string;
}
const { kind, label, file, class: className } = Astro.props;
const tag = { image: 'Image', video: 'Video', '3d': '3D model' }[kind];
---

<div class:list={['placeholder', className]} role="img" aria-label={`${tag} coming soon: ${label}`}>
  <span class="ph-tag">{tag} · coming soon</span>
  <span class="ph-label">{label}</span>
  <code class="ph-file">{file}</code>
</div>

<style>
  .placeholder {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    min-height: 180px;
    height: 100%;
    padding: clamp(12px, 3vw, 20px);
    border: 2px dashed var(--c-line);
    border-radius: var(--radius);
    background: repeating-linear-gradient(-45deg, var(--c-ph-a) 0 12px, var(--c-ph-b) 12px 24px);
    color: var(--c-muted);
  }
  .ph-tag {
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--c-accent);
    color: var(--c-bg); /* >= 4.5:1 against the accent in both themes */
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ph-label {
    color: var(--c-fg);
    font-weight: 700;
    line-height: 1.3;
  }
  .ph-file {
    font-size: 0.75rem;
    word-break: break-all;
  }
</style>
