---
// Masonry-style media grid (CSS columns keep each asset's own aspect ratio,
// no cropping). Items marked span: 'full' break out as full-width rows.
import type { Media } from '../data/projects';
import Picture from './Picture.astro';
import VideoSlot from './VideoSlot.astro';
import ModelSlot from './ModelSlot.astro';
import EmbedFacade from './EmbedFacade.astro';

interface Props {
  media: Media[];
}
const { media } = Astro.props;

// Group consecutive non-full items into column blocks.
const blocks: { full: boolean; items: Media[] }[] = [];
for (const m of media) {
  const full = 'span' in m && m.span === 'full';
  const last = blocks.at(-1);
  if (!full && last && !last.full) last.items.push(m);
  else blocks.push({ full, items: [m] });
}
// Column slot ~ 1/3 of the 2/3 project column on desktop
const colSizes = '(min-width: 1100px) 290px, (min-width: 560px) 45vw, 100vw';
const fullSizes = '(min-width: 1100px) 880px, 100vw';
---

<div class="media">
  {
    blocks.map((block) => (
      <div class:list={[block.full ? 'block-full' : 'block-cols']}>
        {block.items.map((m) => (
          <figure class="item">
            {m.kind === 'image' && <Picture name={m.name} alt={m.alt} sizes={block.full ? fullSizes : colSizes} />}
            {m.kind === 'video' && <VideoSlot name={m.name} label={m.label} poster={m.poster} />}
            {m.kind === 'model' && <ModelSlot name={m.name} label={m.label} poster={m.poster} />}
            {m.kind === 'embed' && <EmbedFacade provider={m.provider} id={m.id} label={m.label} poster={m.poster} />}
          </figure>
        ))}
      </div>
    ))
  }
</div>

<style>
  .media {
    display: grid;
    gap: var(--gap);
  }
  .block-cols {
    columns: 3 150px;
    column-gap: var(--gap);
  }
  .item {
    break-inside: avoid;
    margin-bottom: var(--gap);
  }
  .block-full .item {
    margin-bottom: 0;
  }
  .item :global(img) {
    width: 100%;
    border-radius: var(--radius);
    background: var(--c-bg-raised);
  }
</style>
